{:jolt/min-version "0.8.25"

 :paths ["src"]

 ;; glimmer-cui brings glimmer (components, ratoms) and cui-jolt (the CUI
 ;; binding), and builds its own libcui with the cross-thread wake patch.
 :deps {jolt-lang/glimmer-cui {:git/url "https://github.com/jolt-lang/glimmer-cui"
                               :git/sha "9e9a4a070e7db5cd95451068941e6a31037b88f0"}}

 :aliases {:test {:extra-paths ["test"]}}

 :tasks
 {start {:doc "Start Muse; an optional argument is the working directory"
         :task (apply shell "jolt" "run" "-m" "assistant" *command-line-args*)}
  test  {:doc "Run the tests (no agent or display needed)"
         :task (shell "jolt" "-A:test" "-m" "assistant-test")}}}
